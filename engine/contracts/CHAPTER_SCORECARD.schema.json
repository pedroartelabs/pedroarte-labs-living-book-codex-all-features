{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChapterScorecard",
  "type": "object",
  "required": [
    "chapter",
    "quality",
    "risk"
  ],
  "properties": {
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "quality": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      }
    }
  },
  "additionalProperties": false
}