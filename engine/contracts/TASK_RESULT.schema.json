{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskResult",
  "type": "object",
  "required": [
    "task_id",
    "state",
    "outputs",
    "summary",
    "acceptance_checked"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "APPROVED",
        "CANON_APPROVED",
        "FINAL",
        "REVISION_REQUIRED",
        "FAILED",
        "BLOCKED"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "acceptance_checked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model_tier": {
      "description": "Dosage tier declared for this task's owner in the composed TASK_GRAPH.yaml (S, M or XS), when known. See engine/MODEL_TIERS.yaml.",
      "enum": ["S", "M", "XS"]
    },
    "model_actual": {
      "description": "The concrete model that actually executed this task (e.g. claude-sonnet-5, gpt-5-mini).",
      "type": "string"
    },
    "tokens_in": {
      "type": "number",
      "minimum": 0
    },
    "tokens_out": {
      "type": "number",
      "minimum": 0
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "wall_seconds": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": true
}