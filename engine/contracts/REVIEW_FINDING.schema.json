{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewFinding",
  "type": "object",
  "required": [
    "finding_id",
    "chapter",
    "severity",
    "category",
    "evidence",
    "recommended_action"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "chapter": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        {
          "type": "string",
          "const": "WHOLE_BOOK"
        }
      ]
    },
    "severity": {
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "BLOCKER"
      ]
    },
    "category": {
      "type": "string"
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "recommended_action": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OPEN",
        "ACCEPTED",
        "REJECTED",
        "RESOLVED"
      ]
    }
  },
  "additionalProperties": true
}