{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pedroarte.livingbooks/v1/CARTOGRAPHY.schema.json",
  "title": "CartographySeeds",
  "description": "Contrato dos seeds do canon cartográfico (docs/sdd/*CANONICAL_CARTOGRAPHY_GRAPH_SDD_v0.1.md, seção 31). Cada arquivo *.seed.yaml valida contra este schema pela chave de topo que declara. Regras que JSON Schema não expressa (referências cruzadas, geometria, proteção de mistério) vivem em engine/scripts/check_cartography.py. Não há campo de resposta: a cartografia guarda estrutura, nunca verdade narrativa; a única ponte para a verdade é truth_ref (id opaco).",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "pedroarte.livingbooks/v1"
    },
    "kind": {
      "const": "CartographyCanon"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settings": {
      "type": "object"
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "proposal_ref",
          "cause",
          "chapter"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "proposal_ref": {
            "type": "string"
          },
          "cause": {
            "type": "string"
          },
          "chapter": {
            "type": "integer"
          },
          "target": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "previous_state": {
            "type": "string"
          },
          "new_state": {
            "type": "string"
          },
          "canon_effective_from": {
            "type": "object"
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "edge": {
                  "type": "string"
                },
                "previous_state": {
                  "type": "string"
                },
                "new_state": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "mutation_log": {
      "type": "array"
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Location"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Edge"
      }
    },
    "roads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Road"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Route"
      }
    },
    "addresses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Address"
      }
    },
    "sightlines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Sightline"
      }
    },
    "hideouts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Hideout"
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Boundary"
      }
    },
    "exits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Exit"
      }
    },
    "route_mysteries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RouteMystery"
      }
    },
    "mysteries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CartographicMystery"
      }
    },
    "register": {
      "$ref": "#/$defs/Register"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Artifact"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Anomaly"
      }
    },
    "glyphs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "unlabeled": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "baseline": {
      "type": "array"
    },
    "inventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InventoryItem"
      }
    }
  },
  "$defs": {
    "Id": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Metadata": {
      "type": "object",
      "required": [
        "project_id",
        "sources",
        "grid"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "sources": {
          "type": "string",
          "description": "Caminho relativo ao SOURCES.yaml."
        },
        "grid": {
          "type": "object",
          "required": [
            "origin"
          ],
          "properties": {
            "origin": {
              "type": "string"
            }
          }
        },
        "edges_digitized": {
          "description": "Booleano, ou {LAYER: bool}: só camadas digitalizadas exigem que todo nó pontual tenha aresta (CG-10).",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            }
          ]
        },
        "type_extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Epistemic": {
      "enum": [
        "FACT",
        "OFFICIAL_CLAIM",
        "HISTORICAL_CLAIM",
        "RUMOR",
        "MYSTERY",
        "FALSE_MAP_DATA",
        "UNKNOWN"
      ]
    },
    "SourcePx": {
      "type": "object",
      "required": [
        "source",
        "px"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "px": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "anchor": {
          "enum": [
            "ICON",
            "LABEL",
            "EDGE",
            "SIGN",
            "SCHEMATIC"
          ]
        }
      }
    },
    "Location": {
      "type": "object",
      "required": [
        "id",
        "canonical_name",
        "type",
        "layer"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "canonical_name": {
          "type": "string"
        },
        "names": {
          "type": "array"
        },
        "type": {
          "description": "Vocabulário base (SDD 12.2) + type_extensions do manifesto.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "layer": {
          "enum": [
            "URBAN",
            "REGIONAL",
            "SUBTERRANEAN"
          ]
        },
        "geometry": {
          "enum": [
            "POINT",
            "AREA",
            "LINE"
          ]
        },
        "status": {
          "enum": [
            "ACTIVE",
            "ABANDONED",
            "RUINED",
            "SEALED",
            "RESTRICTED",
            "DISPUTED",
            "UNKNOWN"
          ]
        },
        "epistemic_status": {
          "$ref": "#/$defs/Epistemic"
        },
        "source_px": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourcePx"
          }
        },
        "polyline_px": {
          "type": "array"
        },
        "anchor_to": {
          "type": "string"
        },
        "position": {
          "const": "UNKNOWN"
        },
        "position_accuracy_m": {
          "type": "number",
          "minimum": 0
        },
        "coordinates_cache": {
          "type": "object",
          "description": "Cache derivado; nunca fonte. Diverge da derivada ⇒ CN-05."
        },
        "connectivity": {
          "enum": [
            "UNDECLARED",
            "DECLARED"
          ]
        },
        "source": {
          "enum": [
            "MAP",
            "AUTHOR_DECLARED"
          ]
        },
        "first_allowed_reveal": {
          "oneOf": [
            {
              "const": "OPEN"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "valid_from": {
          "type": [
            "integer",
            "null"
          ]
        },
        "valid_until": {
          "type": [
            "integer",
            "null"
          ]
        },
        "printed": {
          "type": "boolean",
          "description": "false: não consta dos mapas impressos (ligação inferida, nó não desenhado)."
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "true_exit"
            ]
          },
          {
            "required": [
              "truth"
            ]
          },
          {
            "required": [
              "answer"
            ]
          }
        ]
      }
    },
    "Edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "edge_type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "edge_type": {
          "enum": [
            "ROAD",
            "TRAIL",
            "FOREST_PATH",
            "TUNNEL",
            "DRAIN",
            "SECRET_PASSAGE",
            "BRIDGE",
            "WATER_ROUTE",
            "SERVICE_ROUTE",
            "PORTAL",
            "FRAME_LINK",
            "OPEN_GROUND"
          ]
        },
        "directionality": {
          "enum": [
            "BOTH",
            "A_TO_B",
            "B_TO_A"
          ]
        },
        "distance_meters": {
          "type": "object",
          "properties": {
            "nominal": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "basis": {
              "enum": [
                "DIGITIZED",
                "EUCLID_TORTUOSITY",
                "DECLARED",
                "UNSPECIFIED"
              ]
            }
          }
        },
        "secret_level": {
          "enum": [
            "NONE",
            "OBSCURE",
            "HIDDEN",
            "SEALED_SECRET",
            "UNKNOWN"
          ]
        },
        "road": {
          "type": "string"
        },
        "road_class": {
          "enum": [
            "MAIN",
            "SECONDARY",
            "TRAIL",
            "PATH",
            "NONE",
            "UNKNOWN"
          ]
        },
        "terrain": {
          "enum": [
            "ROAD_SURFACE",
            "TRACK",
            "FIELD",
            "FOREST_FLOOR",
            "MARSH",
            "TUNNEL_FLOOR",
            "DRAIN_CHANNEL",
            "CRAWLSPACE",
            "ROCK",
            "STAIRS"
          ]
        },
        "source_polyline_px": {
          "type": "object",
          "required": [
            "source",
            "points"
          ],
          "description": "Traçado em pixels da fonte; o comprimento em metros DERIVA disto (nunca digitado).",
          "properties": {
            "source": {
              "type": "string"
            },
            "points": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "state_timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from_chapter",
              "state"
            ],
            "properties": {
              "from_chapter": {
                "type": "integer",
                "minimum": 0
              },
              "state": {
                "enum": [
                  "OPEN",
                  "RESTRICTED",
                  "BLOCKED",
                  "COLLAPSED",
                  "FLOODED",
                  "SEALED",
                  "DESTROYED",
                  "UNKNOWN"
                ]
              }
            }
          }
        },
        "confidence": {
          "enum": [
            "CONFIRMED_VISUAL",
            "PROBABLE",
            "UNCERTAIN"
          ]
        },
        "access_requirement": {
          "enum": [
            "KEY",
            "PERMIT",
            "CLIMB",
            "SWIM",
            "FORCE",
            "KNOWLEDGE",
            null
          ]
        },
        "route_membership": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "crossings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "water": {
                "type": "string"
              },
              "via": {
                "type": "string"
              }
            }
          }
        },
        "public_knowledge": {
          "enum": [
            "PUBLIC",
            "LOCAL",
            "RESTRICTED",
            "SECRET",
            "UNKNOWN"
          ]
        },
        "printed": {
          "type": "boolean",
          "description": "false: não consta dos mapas impressos (ligação inferida, nó não desenhado)."
        }
      }
    },
    "Road": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "edges": {
          "type": "array"
        },
        "claims": {
          "type": "array"
        }
      }
    },
    "Route": {
      "type": "object",
      "required": [
        "id",
        "label",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "legend_class": {
          "enum": [
            "ESCAPE_ROUTE",
            "CONTESTED",
            "BLOCKED",
            "HIDDEN_PASSAGE"
          ]
        },
        "edges": {
          "type": "array"
        },
        "continuation_beyond_drawn": {
          "const": "UNKNOWN"
        }
      }
    },
    "Address": {
      "type": "object",
      "required": [
        "id",
        "location"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "location": {
          "type": "string"
        }
      }
    },
    "Hideout": {
      "type": "object",
      "required": [
        "id",
        "location"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "capacity": {
          "oneOf": [
            {
              "const": "UNSPECIFIED"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "duration_safe": {
          "oneOf": [
            {
              "const": "UNSPECIFIED"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ],
          "description": "Horas."
        },
        "discoverability": {
          "enum": [
            "OBVIOUS",
            "FINDABLE",
            "OBSCURE",
            "NEAR_IMPOSSIBLE",
            "UNSPECIFIED"
          ]
        },
        "compromise_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event",
              "chapter",
              "effect"
            ],
            "properties": {
              "event": {
                "type": "string"
              },
              "chapter": {
                "type": "integer"
              },
              "effect": {
                "enum": [
                  "COMPROMISED",
                  "DESTROYED",
                  "WATCHED"
                ]
              }
            }
          }
        }
      }
    },
    "Boundary": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "UNCERTAIN_LIMIT",
            "ADMINISTRATIVE",
            "RESTRICTED_ZONE",
            "NATURAL",
            "MAP_FRAME"
          ]
        }
      }
    },
    "Exit": {
      "type": "object",
      "required": [
        "id",
        "physical",
        "exit_classes"
      ],
      "description": "Enum FECHADO de classes de saída: não existe valor de saída verdadeira (INV-C07). O que há além da moldura é sempre OFF_MAP.",
      "properties": {
        "id": {
          "type": "string"
        },
        "road": {
          "type": "string"
        },
        "frame_portal": {
          "type": [
            "string",
            "null"
          ]
        },
        "physical": {
          "type": "object",
          "required": [
            "beyond_frame"
          ],
          "properties": {
            "drawn_to": {
              "enum": [
                "FRAME",
                "DEAD_END",
                "LOOP_WITHIN_FRAME",
                "BLOCKED_POINT",
                "UNKNOWN"
              ]
            },
            "beyond_frame": {
              "const": "OFF_MAP"
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "class": {
                "enum": [
                  "APPARENT_EXIT",
                  "OFFICIAL_EXIT",
                  "HISTORICAL_EXIT",
                  "CLOSED_EXIT",
                  "DISPUTED_EXIT",
                  "FALSE_EXIT",
                  "UNKNOWN_EXIT"
                ]
              }
            }
          }
        },
        "exit_classes": {
          "type": "array",
          "items": {
            "enum": [
              "APPARENT_EXIT",
              "OFFICIAL_EXIT",
              "HISTORICAL_EXIT",
              "CLOSED_EXIT",
              "DISPUTED_EXIT",
              "FALSE_EXIT",
              "UNKNOWN_EXIT"
            ]
          }
        },
        "truth_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "first_allowed_reveal": {
          "oneOf": [
            {
              "const": "OPEN"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        }
      }
    },
    "RouteMystery": {
      "type": "object",
      "required": [
        "id",
        "label",
        "motto",
        "motto_status",
        "resolution_state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "motto": {
          "type": "string"
        },
        "motto_status": {
          "const": "MAP_ARTIFACT"
        },
        "resolution_state": {
          "enum": [
            "UNRESOLVED",
            "PARTIALLY_RESOLVED",
            "RESOLVED",
            "PERMANENTLY_AMBIGUOUS"
          ]
        },
        "truth_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CartographicMystery": {
      "type": "object",
      "required": [
        "id",
        "question",
        "resolution_state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "resolution_state": {
          "enum": [
            "UNRESOLVED",
            "PARTIALLY_RESOLVED",
            "RESOLVED",
            "PERMANENTLY_AMBIGUOUS"
          ]
        },
        "question_policy": {
          "enum": [
            "NEVER",
            "LATE_PARTIAL",
            "RESOLVED_AT"
          ]
        },
        "candidate_interpretations": {
          "type": "array",
          "description": "Sem valor de verdade: nenhum campo plausible/true/false/score."
        },
        "truth_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "question_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Register": {
      "type": "object",
      "required": [
        "entries",
        "printed_order_is_artifact"
      ],
      "properties": {
        "expected_lines": {
          "type": "integer"
        },
        "printed_order_is_artifact": {
          "const": true
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "display_index",
              "printed_name",
              "placement"
            ],
            "properties": {
              "display_index": {
                "type": "string",
                "description": "String literal: preserva zeros e duplicatas."
              },
              "placement": {
                "enum": [
                  "ON_MAP",
                  "NOT_ON_MAP",
                  "NO_STANDALONE_LABEL"
                ]
              },
              "ordering_significance": {
                "enum": [
                  "UNKNOWN",
                  "ADMINISTRATIVE",
                  "CHRONOLOGICAL",
                  "CARTOGRAPHIC",
                  "ENCRYPTED",
                  "DECOY"
                ]
              }
            }
          }
        }
      }
    },
    "Artifact": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "MAP",
            "TEXT",
            "FIGURE",
            "GLYPH_SET",
            "MARKER",
            "ORNAMENT",
            "REGISTER"
          ]
        },
        "epistemic_status": {
          "$ref": "#/$defs/Epistemic"
        },
        "author": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "MUST_REMAIN_UNKNOWN"
            }
          }
        },
        "depicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Depiction"
          }
        },
        "printed_in_book": {
          "type": "boolean"
        },
        "map_layer": {
          "type": "string"
        }
      }
    },
    "Anomaly": {
      "type": "object",
      "required": [
        "id",
        "classification"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "classification": {
          "enum": [
            "UNDECIDED",
            "INTENTIONAL_ARTIFACT",
            "RENDER_ERROR"
          ]
        },
        "decided_by": {
          "type": "string"
        }
      }
    },
    "InventoryItem": {
      "type": "object",
      "required": [
        "item",
        "maps_to"
      ],
      "properties": {
        "item": {
          "type": "string"
        },
        "maps_to": {
          "type": "string"
        }
      }
    },
    "Staging": {
      "type": "object",
      "required": [
        "id",
        "actor",
        "location",
        "at"
      ],
      "properties": {
        "at": {
          "type": "string",
          "pattern": "^D[0-9]+T[0-9]{2}:[0-9]{2}$"
        },
        "role": {
          "enum": [
            "HIDING",
            "PRESENT",
            "PASSING"
          ]
        },
        "sees": {
          "type": "array"
        },
        "ledger_event": {
          "type": "string"
        },
        "group_size": {
          "type": "integer",
          "minimum": 1
        },
        "conditions": {
          "type": "object"
        }
      }
    },
    "Movement": {
      "type": "object",
      "required": [
        "id",
        "from_staging",
        "to_staging"
      ],
      "properties": {
        "mode": {
          "enum": [
            "WALK",
            "RUN",
            "CRAWL",
            "VEHICLE"
          ]
        },
        "route": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "access_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditions": {
          "type": "object"
        }
      }
    },
    "Sightline": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "result",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "symmetric": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "description": "Proposta aprovada: visibilidade não se decide por conveniência de cena."
        },
        "result": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "VISIBLE",
              "PARTIAL",
              "NOT_VISIBLE"
            ]
          },
          "description": "Chaves: DAYLIGHT (também OVERCAST), TWILIGHT, NIGHT_MOON, NIGHT_DARK."
        }
      }
    },
    "Chase": {
      "type": "object",
      "required": [
        "id",
        "target",
        "pursuer"
      ],
      "properties": {
        "lighting": {
          "enum": [
            "DAYLIGHT",
            "OVERCAST",
            "TWILIGHT",
            "NIGHT_MOON",
            "NIGHT_LIGHT",
            "NIGHT_DARK"
          ]
        },
        "initial_gap_m": {
          "type": "number",
          "minimum": 0
        },
        "initial_visibility": {
          "enum": [
            "VISIBLE",
            "NOT_VISIBLE",
            "UNKNOWN"
          ]
        },
        "target": {
          "type": "object",
          "required": [
            "actor",
            "start"
          ]
        },
        "pursuer": {
          "type": "object",
          "required": [
            "actor",
            "start"
          ]
        },
        "declared_events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "ARRIVES",
                  "PURSUER_REACHES",
                  "TARGET_REACHES",
                  "INTERCEPT",
                  "GAP_CLOSED",
                  "SIGHT_REACQUIRED"
                ]
              }
            }
          }
        }
      }
    },
    "Depiction": {
      "type": "object",
      "required": [
        "target",
        "relation"
      ],
      "description": "Relação entre o que um mapa mostra e o grafo físico (SDD 22.2). Diferente de ACCURATE é afirmação sobre a verdade: exige base física verificável ou truth_ref.",
      "properties": {
        "target": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "ACCURATE",
            "OMITS",
            "PHANTOM",
            "FALSIFIED_STATUS",
            "RENAMED",
            "MISPLACED",
            "FALSIFIED_ACCESS"
          ]
        },
        "as_name": {
          "type": "string"
        },
        "as_status": {
          "type": "string"
        },
        "as_position_px": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "truth_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Único vínculo com a verdade (id opaco do Story Truth Ledger)."
        }
      }
    }
  },
  "additionalProperties": true
}
