# Modelo de configuração de credenciais. COPIE para `.env` e preencha lá.
# `.env` está no .gitignore; este arquivo (.env.example) NÃO deve conter
# nenhuma chave real — apenas o nome das variáveis.
#
# Windows PowerShell (sessão atual):
#   $env:OPENAI_API_KEY = "sua-chave-aqui"
#
# Windows PowerShell (persistente para o usuário):
#   [Environment]::SetEnvironmentVariable("OPENAI_API_KEY", "sua-chave-aqui", "User")
#
# bash/zsh:
#   export OPENAI_API_KEY="sua-chave-aqui"

# Usada por engine/scripts/generate_image.py para gerar as imagens de
# capítulo, a capa KDP e os Stories via API de imagem da OpenAI.
OPENAI_API_KEY=

# Opcional: sobrescreve o modelo de imagem padrão do script.
# LIVINGBOOK_IMAGE_MODEL=gpt-image-1
